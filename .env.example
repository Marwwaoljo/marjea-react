# Local runtime
NODE_ENV=development
PORT=8080
VITE_PORT=5173
BASE_PATH=/
LOG_LEVEL=info

# Public frontend configuration (safe to expose only where explicitly intended)
VITE_CLERK_PUBLISHABLE_KEY=
VITE_CLERK_PROXY_URL=
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=
BASE_URL=

# Clerk server credentials — keep secret key on the server only
CLERK_PUBLISHABLE_KEY=pk_test_c2hhcnAtZG9yeS02MDgzLmNsZXJrLmFjY291bnRzLmRldiQ
CLERK_SECRET_KEY=sk_test_MPN1EO5BdjnqIqXp8ILPg0LgWXAM0XSLMj2wpqXfFH

# Dedicated Neon PostgreSQL development database.
# Migration role and runtime role must be different least-privilege users.
MARJEA_DATABASE_ENVIRONMENT=
MARJEA_MIGRATION_DATABASE_URL=
# Use a least-privilege runtime role; never use a superuser or production URL.
MARJEA_DATABASE_URL=
MARJEA_EXPECTED_DATABASE_NAME=

# Firebase Admin: service-account JSON string, server-side only
FIREBASE_SERVICE_ACCOUNT_JSON=

# Direct provider credentials — server-side only
OPENAI_API_KEY=
RESEND_API_KEY=
MARJEA_RESEND_FROM=

# Cloudflare R2 - Private Institution Documents
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=
R2_ENDPOINT=
R2_REGION=auto
R2_PRIVATE_PREFIX=institution-licenses/

# Application session and service bridges
SESSION_SECRET=
MARJEA_JAVA_PORT=8099
MARJEA_GOVERNMENT_REFERRAL_BRIDGE_SECRET=
MARJEA_INDIVIDUAL_BRIDGE_SECRET=

# Optional product/security settings
MARJEA_BLOCKED_EMAIL_DOMAINS=
MARJEA_VERIFIED_INSTITUTION_EMAIL_DOMAINS=
MARJEA_INSTITUTION_VERIFICATION_ENFORCEMENT=false
MARJEA_INSTITUTION_REVIEWER_IDS=
MARJEA_INDIVIDUAL_PROFILE_ENABLED=false
TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_SECRET=

# Test-only variables. Use only with disposable test databases.
MARJEA_RLS_TEST_ADMIN_DATABASE_URL=
MARJEA_RLS_TEST_DATABASE_URL=
MARJEA_RUN_DB_TESTS=0
MARJEA_RUN_LIVE_AI_TESTS=0
MARJEA_RUN_COVERAGE_PERF=0
MARJEA_TEST_SCHEMA=
